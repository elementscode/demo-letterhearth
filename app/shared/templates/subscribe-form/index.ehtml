import "./style.css";
import { redirect } from "@elements/app";
import config from "#config";
import { errorMessage } from "#app/shared/format";
import { subscribe, startUpgrade, Plan } from "#app/shared/services/subscribers";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field, FieldLabel, FieldContent, FieldTitle, FieldDescription } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";

/** Who is looking at the form: a signed-in reader, or nobody. */
export interface ReaderState {
  email: string;
  plan: Plan;
}

interface SubscribeState {
  email: string;
  plan: Plan;
  error: string;
  done: string;
  busy: boolean;
}

const PRICE = `$${(config.newsletter.priceCents / 100).toFixed(0)}`;

async function onSubscribe(form: SubscribeState) {
  form.error = "";
  form.busy = true;

  try {
    let result = await subscribe(form.email, form.plan);

    switch (result.status) {
      case "checkout":
        redirect(result.url);
        return;

      case "subscribed":
        form.done = "You're subscribed. A welcome letter is on its way to your inbox.";
        break;

      case "check-inbox":
        form.done = "That address is already on the list. We've emailed it a sign-in link.";
        break;

      case "already":
        form.done = "You're already subscribed.";
        break;
    }
  } catch (err: any) {
    form.error = errorMessage(err);
  } finally {
    form.busy = false;
  }
}

async function onUpgrade(form: SubscribeState) {
  form.error = "";
  form.busy = true;

  try {
    redirect(await startUpgrade());
  } catch (err: any) {
    form.error = errorMessage(err);
    form.busy = false;
  }
}

<SubscribeForm (
  reader: ReaderState | null,
  plan: Plan = "free",
  private form: SubscribeState = { email: "", plan, error: "", done: "", busy: false },
)>
  <div class="subscribe-form stack">
    <Alert e:if={form.error} variant="danger">{form.error}</Alert>

    <Alert e:if={form.done} variant="success" role="status">{form.done}</Alert>

    <div e:elseif={reader && reader.plan === "paid"} class="stack is-sm">
      <p><strong>You're a paid subscriber.</strong> Every letter is open to you.</p>
      <a class="link-action" href="/account">Manage your subscription</a>
    </div>

    <div e:elseif={reader} class="stack is-sm">
      <p>
        You're subscribed for free as <strong>{reader?.email}</strong>.
        Upgrade for {PRICE} a month to read every paid letter in full.
      </p>
      <div class="cluster">
        <Button variant="primary" loading={form.busy} onclick={() => onUpgrade(form)}>
          Upgrade for {PRICE}/month
        </Button>
        <a class="link-muted" href="/account">Your account</a>
      </div>
    </div>

    <form e:else class="stack" onsubmit={() => onSubscribe(form)}>
      <RadioGroup value={form.plan} name="plan" class="plans" attrs={{ "aria-label": "Plan" }}>
        <FieldLabel>
          <Field orientation="horizontal" reserveError={false}>
            <RadioGroupItem value="free" />
            <FieldContent>
              <FieldTitle>Free</FieldTitle>
              <FieldDescription>Free letters in full, and the opening of every paid one.</FieldDescription>
            </FieldContent>
          </Field>
        </FieldLabel>

        <FieldLabel>
          <Field orientation="horizontal" reserveError={false}>
            <RadioGroupItem value="paid" />
            <FieldContent>
              <FieldTitle>Paid · {PRICE}/month</FieldTitle>
              <FieldDescription>Every letter in full. Cancel any time.</FieldDescription>
            </FieldContent>
          </Field>
        </FieldLabel>
      </RadioGroup>

      <div class="subscribe-row row">
        <Input type="email"
               name="email"
               value={form.email}
               class="subscribe-email"
               placeholder="you@example.com"
               required
               attrs={{ "aria-label": "Email address", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
        <Button type="submit" variant="primary" loading={form.busy}>
          {form.plan === "paid" ? "Continue to payment" : "Subscribe"}
        </Button>
      </div>

      <p class="fine">
        Paid plans are billed monthly by card through Stripe. Every email has a one-click unsubscribe link.
      </p>
    </form>
  </div>
</SubscribeForm>
