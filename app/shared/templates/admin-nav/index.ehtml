import { Tabs, TabsList, TabsTrigger } from "@elements/ui/tabs";

<AdminNav (active: "subscribers" | "posts")>
  <Tabs value={active}>
    <TabsList label="Writer">
      <TabsTrigger value="subscribers" href="/admin">Subscribers</TabsTrigger>
      <TabsTrigger value="posts" href="/admin/posts">Posts</TabsTrigger>
    </TabsList>
  </Tabs>
</AdminNav>
