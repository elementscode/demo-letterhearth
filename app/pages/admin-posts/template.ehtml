import "./style.css";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { AdminNav } from "#app/shared/templates/admin-nav";
import { Access } from "#app/shared/services/posts";
import { formatShortDate } from "#app/shared/format";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Empty, EmptyContent } from "@elements/ui/empty";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { Toast } from "@elements/ui/toast";

export interface PostListRow {
  id: string;
  title: string;
  slug: string;
  access: Access;
  publishAt: Date | null;
  sentAt: Date | null;
  recipientCount: number;
}

const NOTICES: Record<string, string> = {
  published: "Published. The emails are going out now.",
  scheduled: "Scheduled. It publishes and sends at the time you chose.",
  draft: "Draft saved.",
  saved: "Changes saved.",
  deleted: "Draft deleted.",
};

function whenLabel(p: PostListRow): string {
  if (p.sentAt) {
    return `Sent ${formatShortDate(p.sentAt)}`;
  }

  if (p.publishAt) {
    return `Sends ${p.publishAt.toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" })}`;
  }

  return "Not scheduled";
}

<html lang="en" class="page-admin-posts" (posts: PostListRow[], done: string)>
  <head>
    <title>Posts · {config.newsletter.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout wide={true}>
      <div class="page-shell is-wide stack is-xl">
        <div class="admin-head row">
          <div class="stack is-xs">
            <p class="eyebrow">Writer</p>
            <h1>{config.newsletter.name}</h1>
          </div>
          <Button variant="primary" href="/admin/posts/new">New post</Button>
        </div>

        <AdminNav active="posts" />

        <Toast e:if={NOTICES[done]} open title={NOTICES[done]} type="success" />

        <Table e:if={posts.length > 0} label="Posts">
          <table>
            <thead>
              <tr>
                <TableHead>Title</TableHead>
                <TableHead>Status</TableHead>
                <TableHead>Access</TableHead>
                <TableHead align="end" class="num">Recipients</TableHead>
              </tr>
            </thead>
            <tbody>
              <tr e:for={p of posts}>
                <TableCell class="title"><a href={`/admin/posts/${p.id}`}>{p.title}</a></TableCell>
                <TableCell>
                  <div class="cluster is-sm">
                    <Badge e:if={p.sentAt} variant="success" dot>Published</Badge>
                    <Badge e:elseif={p.publishAt} variant="warning" dot>Scheduled</Badge>
                    <Badge e:else variant="secondary">Draft</Badge>
                    <span class="when">{whenLabel(p)}</span>
                  </div>
                </TableCell>
                <TableCell>
                  <Badge e:if={p.access === "paid"} variant="accent">Paid</Badge>
                  <Badge e:else variant="secondary">Free</Badge>
                </TableCell>
                <TableCell align="end" class="num">{p.sentAt ? p.recipientCount : "–"}</TableCell>
              </tr>
            </tbody>
          </table>
        </Table>

        <Empty e:else title="No posts yet" variant="outline">
          <EmptyContent>
            <Button variant="primary" href="/admin/posts/new">Write the first one</Button>
          </EmptyContent>
        </Empty>
      </div>
    </Layout>
  </body>
</html>
