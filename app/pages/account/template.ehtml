import "./style.css";
import { redirect } from "@elements/app";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import {
  AccountView,
  cancelSubscription,
  resumeSubscription,
  setEmailsEnabled,
  startUpgrade,
} from "#app/shared/services/subscribers";
import { errorMessage, formatDate } from "#app/shared/format";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent } from "@elements/ui/card";

interface AccountState {
  view: AccountView;
  error: string;
  busy: boolean;
}

const PRICE = `$${(config.newsletter.priceCents / 100).toFixed(0)}`;

async function run(state: AccountState, action: () => Promise<AccountView | void>) {
  state.error = "";
  state.busy = true;

  try {
    let view = await action();

    if (view) {
      state.view = view;
    }
  } catch (err: any) {
    state.error = errorMessage(err);
  } finally {
    state.busy = false;
  }
}

async function onUpgrade(state: AccountState) {
  await run(state, async () => redirect(await startUpgrade()));
}

async function onCancel(state: AccountState) {
  await run(state, () => cancelSubscription());
}

async function onResume(state: AccountState) {
  await run(state, () => resumeSubscription());
}

async function onEmails(state: AccountState, enabled: boolean) {
  await run(state, async () => setEmailsEnabled(enabled));
}

<html lang="en" class="page-account" (
  initial: AccountView,
  paidNotice: "" | "paid" | "processing",
  private state: AccountState = { view: initial, error: "", busy: false },
)>
  <head>
    <title>Your account · {config.newsletter.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-form stack is-xl">
        <div class="stack is-xs">
          <h1>Your subscription</h1>
          <p class="muted">Signed in as {state.view.email}</p>
        </div>

        <Alert e:if={paidNotice === "paid"} variant="success" role="status">
          Payment received. You're a paid subscriber, and every letter is open to you.
        </Alert>
        <Alert e:if={paidNotice === "processing"} variant="warning" role="status">
          Your payment is processing. Your plan updates here as soon as Stripe confirms it.
        </Alert>
        <Alert e:if={state.error} variant="danger">{state.error}</Alert>

        <Card title="Plan" level={2}>
          <CardAction slot="action">
            <Badge e:if={state.view.plan === "paid"} variant="accent">Paid</Badge>
            <Badge e:else variant="secondary">Free</Badge>
          </CardAction>

          <CardContent class="stack">
            <div e:if={state.view.plan === "free"} class="stack is-sm">
              <p>
                You get every free letter in full, and the opening of every paid one.
                Upgrade for {PRICE} a month to read everything.
              </p>
              <div>
                <Button variant="primary" disabled={state.busy} onclick={() => onUpgrade(state)}>
                  Upgrade for {PRICE}/month
                </Button>
              </div>
            </div>

            <div e:elseif={state.view.cancelAtPeriodEnd} class="stack is-sm">
              <p>
                Your paid subscription is cancelled. You keep paid access
                <span e:if={state.view.currentPeriodEnd}>until {formatDate(state.view.currentPeriodEnd!)}</span>,
                then move to the free plan.
              </p>
              <div>
                <Button variant="primary" disabled={state.busy} onclick={() => onResume(state)}>
                  Keep my paid subscription
                </Button>
              </div>
            </div>

            <div e:else class="stack is-sm">
              <p>
                {PRICE} a month<span e:if={!state.view.billedByStripe}>, complimentary</span>.
                <span e:if={state.view.currentPeriodEnd}>Renews {formatDate(state.view.currentPeriodEnd!)}.</span>
                Thank you for supporting {config.newsletter.name}.
              </p>
              <div>
                <AlertDialog title="Cancel your paid subscription?"
                             description="You keep paid access until the end of this period."
                             size="sm">
                  <Button slot="trigger" disabled={state.busy}>Cancel subscription</Button>
                  <AlertDialogFooter>
                    <AlertDialogCancel>Keep my subscription</AlertDialogCancel>
                    <AlertDialogAction variant="danger" onclick={() => onCancel(state)}>Cancel subscription</AlertDialogAction>
                  </AlertDialogFooter>
                </AlertDialog>
              </div>
            </div>
          </CardContent>
        </Card>

        <Card title="Email" level={2}>
          <CardAction slot="action">
            <Badge e:if={state.view.emailsEnabled} variant="success" dot>On</Badge>
            <Badge e:else variant="secondary">Off</Badge>
          </CardAction>

          <CardContent class="stack is-sm">
            <p e:if={state.view.emailsEnabled}>New letters arrive at {state.view.email}.</p>
            <p e:else>
              You're not getting letters by email.
              <span e:if={state.view.plan === "paid"}>Your paid plan is unchanged, and every letter is here on the site.</span>
            </p>
            <div>
              <Button e:if={state.view.emailsEnabled} disabled={state.busy} onclick={() => onEmails(state, false)}>
                Stop emails
              </Button>
              <Button e:else variant="primary" disabled={state.busy} onclick={() => onEmails(state, true)}>
                Send me letters again
              </Button>
            </div>
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>
