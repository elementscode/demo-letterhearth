import "./style.css";
import { redirect } from "@elements/app";
import config from "#config";
import { errorMessage } from "#app/shared/format";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { writerSignin, WRITER_DEMO } from "#app/shared/services/auth";
import { requestSigninLink } from "#app/shared/services/subscribers";
import { Alert, AlertTitle, AlertDescription } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface WriterForm {
  email: string;
  password: string;
  error: string;
}

interface ReaderForm {
  email: string;
  error: string;
  sent: boolean;
}

function onWriterSignin(form: WriterForm) {
  try {
    writerSignin(form.email, form.password);
    form.error = "";
    redirect("/admin");
  } catch (err: any) {
    form.error = errorMessage(err);
  }
}

function onReaderLink(form: ReaderForm) {
  try {
    requestSigninLink(form.email);
    form.error = "";
    form.sent = true;
  } catch (err: any) {
    form.error = errorMessage(err);
  }
}

function fillDemo(form: WriterForm) {
  form.email = WRITER_DEMO.email;
  form.password = WRITER_DEMO.password;
}

<html lang="en" class="page-signin" (
  expired: boolean,
  private writer: WriterForm = { email: "", password: "", error: "" },
  private reader: ReaderForm = { email: "", error: "", sent: false },
)>
  <head>
    <title>Sign in · {config.newsletter.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-form stack is-xl">
        <h1>Sign in</h1>

        <Alert e:if={expired} variant="warning" role="none">
          That sign-in link has expired or was already used. Ask for a new one below.
        </Alert>

        <Card class="panel">
          <CardContent class="stack">
            <div class="stack is-xs">
              <h2>Readers</h2>
              <p>We'll email you a link that signs you in. No password needed.</p>
            </div>

            <Alert e:if={reader.sent} variant="success" role="status">
              If {reader.email} is subscribed, a sign-in link is on its way. It works for an hour.
            </Alert>

            <form e:else class="stack" onsubmit={() => onReaderLink(reader)}>
              <Alert e:if={reader.error} variant="danger">{reader.error}</Alert>
              <Field label="Email" required>
                <Input type="email"
                       name="email"
                       value={reader.email}
                       placeholder="you@example.com"
                       attrs={{ id: "reader-email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>
              <div>
                <Button type="submit" variant="primary">Email me a sign-in link</Button>
              </div>
            </form>
          </CardContent>
        </Card>

        <Card class="panel">
          <CardContent class="stack">
            <div class="stack is-xs">
              <h2>The writer</h2>
              <p>Sign in to write posts and see your subscribers.</p>
            </div>

            <Alert variant="accent" role="none" class="demo">
              <AlertTitle>Demo writer account</AlertTitle>
              <AlertDescription class="stack is-sm">
                <dl>
                  <dt>Email</dt>
                  <dd>{WRITER_DEMO.email}</dd>
                  <dt>Password</dt>
                  <dd>{WRITER_DEMO.password}</dd>
                </dl>
                <div>
                  <Button size="sm" onclick={() => fillDemo(writer)}>Fill in the demo login</Button>
                </div>
              </AlertDescription>
            </Alert>

            <form class="stack" onsubmit={() => onWriterSignin(writer)}>
              <Alert e:if={writer.error} variant="danger">{writer.error}</Alert>
              <Field label="Email" required>
                <Input type="email"
                       name="email"
                       value={writer.email}
                       attrs={{ id: "writer-email", autocomplete: "username", autocapitalize: "none", spellcheck: "false" }} />
              </Field>
              <Field label="Password" required>
                <Input type="password"
                       name="password"
                       value={writer.password}
                       attrs={{ id: "writer-password", autocomplete: "current-password" }} />
              </Field>
              <div>
                <Button type="submit" variant="primary">Sign in as the writer</Button>
              </div>
            </form>
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>
