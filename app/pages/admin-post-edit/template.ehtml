import "./style.css";
import { raw, redirect } from "@elements/app";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import {
  Access,
  Post,
  PublishWhen,
  deletePost,
  renderMarkdown,
  savePost,
  slugify,
  splitTeaser,
  TEASER_PARAGRAPHS,
} from "#app/shared/services/posts";
import { Audience } from "#app/shared/services/subscribers";
import { errorMessage, formatDate } from "#app/shared/format";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Button } from "@elements/ui/button";
import { DatePicker } from "@elements/ui/date-picker";
import { Field, FieldLabel, FieldContent, FieldTitle, FieldDescription, FieldSet, FieldLegend } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { RadioGroup, RadioGroupItem } from "@elements/ui/radio-group";
import { Textarea } from "@elements/ui/textarea";
import { TimePicker } from "@elements/ui/time-picker";

type Mode = "draft" | "now" | "schedule";

interface EditorState {
  title: string;
  slug: string;
  body: string;
  access: Access;
  mode: Mode;
  scheduleDate: string;
  scheduleTime: string;
  slugTouched: boolean;
  error: string;
  busy: boolean;
  confirming: boolean;
}

const STARTER = `Write the opening paragraph here. It is what every reader sees first.

Write a second paragraph. On a paid post, readers who are not paying see this far.

## A heading

Everything after the first ${TEASER_PARAGRAPHS} paragraphs of a paid post is for paid subscribers.
`;

const pad = (n: number) => String(n).padStart(2, "0");

/** A Date's day as the ISO date a DatePicker takes, in the browser's time zone. */
function toLocalDate(date: Date): string {
  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
}

/** A Date's time of day as the "HH:MM" a TimePicker takes. */
function toLocalTime(date: Date): string {
  return `${pad(date.getHours())}:${pad(date.getMinutes())}`;
}

function tomorrowMorning(): Date {
  let d = new Date();
  d.setDate(d.getDate() + 1);
  d.setHours(8, 0, 0, 0);

  return d;
}

function initialState(post: Post | null): EditorState {
  let scheduled = post?.publishAt && !post.sentAt ? post.publishAt : null;
  let at = scheduled ?? tomorrowMorning();

  return {
    title: post?.title ?? "",
    slug: post?.slug ?? "",
    body: post?.body ?? STARTER,
    access: post?.access ?? "free",
    mode: scheduled ? "schedule" : "draft",
    scheduleDate: toLocalDate(at),
    scheduleTime: toLocalTime(at),
    slugTouched: post !== null,
    error: "",
    busy: false,
    confirming: false,
  };
}

function onTitle(state: EditorState) {
  if (!state.slugTouched) {
    state.slug = slugify(state.title);
  }
}

function recipientsFor(audience: Audience): number {
  return audience.paid + audience.free;
}

function saveLabel(post: Post | null, state: EditorState): string {
  if (post?.sentAt) {
    return "Save changes";
  }

  switch (state.mode) {
    case "now":
      return "Publish and send";

    case "schedule":
      return "Schedule";

    default:
      return "Save draft";
  }
}

function onSave(post: Post | null, state: EditorState) {
  state.error = "";

  let when: PublishWhen = null;

  if (!post?.sentAt) {
    if (state.mode === "now") {
      state.confirming = true;
      return;
    }

    if (state.mode === "schedule") {
      let at = new Date(`${state.scheduleDate}T${state.scheduleTime}`);
      when = at;

      if (isNaN(+at) || at <= new Date()) {
        state.error = "Choose a time in the future to schedule this post.";
        return;
      }
    }
  }

  save(post, state, when);
}

function save(post: Post | null, state: EditorState, when: PublishWhen) {
  state.busy = true;

  try {
    savePost(
      post?.id ?? null,
      { title: state.title, slug: state.slug, body: state.body, access: state.access },
      when,
    );

    let done = post?.sentAt ? "saved" : state.mode === "now" ? "published" : state.mode === "schedule" ? "scheduled" : "draft";
    redirect(`/admin/posts?done=${done}`);
  } catch (err: any) {
    state.error = errorMessage(err);
    state.busy = false;
  }
}

function onDelete(post: Post) {
  deletePost(post.id);
  redirect("/admin/posts?done=deleted");
}

function today(): string {
  return toLocalDate(new Date());
}

<html lang="en" class="page-admin-post-edit" (
  post: Post | null,
  audience: Audience,
  private state: EditorState = initialState(post),
)>
  <head>
    <title>{post ? "Edit post" : "New post"} · {config.newsletter.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout wide={true}>
      <form class="page-shell is-wide stack is-lg" onsubmit={() => onSave(post, state)}>
        <div class="editor-head row">
          <div class="stack is-xs">
            <a class="link-muted" href="/admin/posts">← Posts</a>
            <h1>{post ? "Edit post" : "New post"}</h1>
          </div>
          <div class="cluster">
            <Button e:if={post?.sentAt} variant="ghost" href={`/p/${post?.slug}`}>View on the site</Button>
            <Button type="submit" variant="primary" loading={state.busy}>{saveLabel(post, state)}</Button>
          </div>
        </div>

        <Alert e:if={state.error} variant="danger">{state.error}</Alert>

        <Alert e:if={post?.sentAt} variant="success" role="none">
          Published {formatDate(post?.sentAt!)} and sent to {post?.recipientCount} subscribers.
          Edits update the post on the site; the emails have already gone.
        </Alert>

        <div class="meta-fields">
          <Field label="Title" required>
            <Input value={state.title} oninput={() => onTitle(state)} placeholder="A letter about…"
                   attrs={{ id: "title" }} />
          </Field>
          <Field label="Address" description={`/p/${state.slug || "…"}`} required>
            <Input value={state.slug} oninput={() => state.slugTouched = true} placeholder="a-letter-about"
                   attrs={{ id: "slug", autocapitalize: "none", spellcheck: "false" }} />
          </Field>
        </div>

        <div class="split">
          <div class="stack is-sm">
            <div class="pane-label row">
              <label for="body">Markdown</label>
              <span>{state.body.trim() ? state.body.trim().split(/\s+/).length : 0} words</span>
            </div>
            <Textarea value={state.body} class="source" autosize={false} attrs={{ id: "body", spellcheck: "true" }} />
          </div>

          <div class="stack is-sm">
            <div class="pane-label row">
              <span>Preview</span>
              <span e:if={state.access === "paid"}>Readers who aren't paying see down to the line</span>
            </div>
            <div class="preview">
              <h2 class="preview-title">{state.title || "Untitled"}</h2>
              <div e:if={state.access === "paid"} class="prose">
                {raw(renderMarkdown(splitTeaser(state.body).teaser))}
                <p class="teaser-mark">Paid subscribers only below this line</p>
                {raw(renderMarkdown(splitTeaser(state.body).rest))}
              </div>
              <div e:else class="prose">{raw(renderMarkdown(state.body))}</div>
            </div>
          </div>
        </div>

        <FieldSet disabled={!!post?.sentAt}>
          <FieldLegend>Who can read it</FieldLegend>
          <RadioGroup value={state.access} name="access" class="choices" attrs={{ "aria-label": "Who can read it" }}>
            <FieldLabel>
              <Field orientation="horizontal" reserveError={false}>
                <RadioGroupItem value="free" />
                <FieldContent>
                  <FieldTitle>Free</FieldTitle>
                  <FieldDescription>Everyone reads it in full, by email and on the site.</FieldDescription>
                </FieldContent>
              </Field>
            </FieldLabel>
            <FieldLabel>
              <Field orientation="horizontal" reserveError={false}>
                <RadioGroupItem value="paid" />
                <FieldContent>
                  <FieldTitle>Paid</FieldTitle>
                  <FieldDescription>In full for paid subscribers; a teaser and a link for everyone else.</FieldDescription>
                </FieldContent>
              </Field>
            </FieldLabel>
          </RadioGroup>
        </FieldSet>

        <FieldSet e:if={!post?.sentAt}>
          <FieldLegend>When</FieldLegend>
          <RadioGroup value={state.mode} name="mode" class="choices" attrs={{ "aria-label": "When" }}>
            <FieldLabel>
              <Field orientation="horizontal" reserveError={false}>
                <RadioGroupItem value="draft" />
                <FieldContent>
                  <FieldTitle>Draft</FieldTitle>
                  <FieldDescription>Saved, not published.</FieldDescription>
                </FieldContent>
              </Field>
            </FieldLabel>
            <FieldLabel>
              <Field orientation="horizontal" reserveError={false}>
                <RadioGroupItem value="now" />
                <FieldContent>
                  <FieldTitle>Publish now</FieldTitle>
                  <FieldDescription>Emails {recipientsFor(audience)} subscribers right away.</FieldDescription>
                </FieldContent>
              </Field>
            </FieldLabel>
            <FieldLabel>
              <Field orientation="horizontal" reserveError={false}>
                <RadioGroupItem value="schedule" />
                <FieldContent>
                  <FieldTitle>Schedule</FieldTitle>
                  <FieldDescription>Publishes and sends at a time you pick.</FieldDescription>
                </FieldContent>
              </Field>
            </FieldLabel>
          </RadioGroup>

          <div e:if={state.mode === "schedule"} class="schedule-at cluster">
            <Field label="Publish on">
              <DatePicker value={state.scheduleDate} min={today()} required />
            </Field>
            <Field label="At">
              <TimePicker value={state.scheduleTime} required />
            </Field>
          </div>

          <p e:if={state.mode !== "draft"} class="hint">
            <span e:if={state.access === "paid"}>
              {audience.paid} paid subscribers get the whole post; {audience.free} free subscribers get the opening and a link.
            </span>
            <span e:else>All {recipientsFor(audience)} subscribers get the whole post.</span>
          </p>
        </FieldSet>

        <div class="actions row">
          <AlertDialog e:if={post && !post.sentAt} title="Delete this draft?" description="This can't be undone." size="sm">
            <Button slot="trigger" variant="ghost" class="delete-draft">Delete draft</Button>
            <AlertDialogFooter>
              <AlertDialogCancel>Cancel</AlertDialogCancel>
              <AlertDialogAction variant="danger" onclick={() => onDelete(post!)}>Delete</AlertDialogAction>
            </AlertDialogFooter>
          </AlertDialog>
          <span e:else></span>
          <Button type="submit" variant="primary" loading={state.busy}>{saveLabel(post, state)}</Button>
        </div>

        <AlertDialog open={state.confirming}
                     title={`Publish "${state.title || "this post"}" now and email it to ${recipientsFor(audience)} subscribers?`}>
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction onclick={() => save(post, state, "now")}>Publish and send</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialog>
      </form>
    </Layout>
  </body>
</html>
