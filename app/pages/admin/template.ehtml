import "./style.css";
import { LiveView } from "@elements/app";
import config from "#config";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { AdminNav } from "#app/shared/templates/admin-nav";
import { SubscriberRow, statsOf } from "#app/shared/services/subscribers";
import { formatDollars } from "#app/shared/format";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { DataTable, DataTableColumn } from "@elements/ui/data-table";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";

export type Filter = "all" | "paid" | "free" | "unsubscribed";

export function filterRows(rows: SubscriberRow[], filter: Filter): SubscriberRow[] {
  let kept = rows.filter((r) => {
    switch (filter) {
      case "paid":
        return r.plan === "paid";

      case "free":
        return r.plan === "free" && r.emailsEnabled;

      case "unsubscribed":
        return !r.emailsEnabled;

      default:
        return true;
    }
  });

  return kept.sort((a, b) => +b.createdAt - +a.createdAt);
}

const COLUMNS: DataTableColumn[] = [
  { key: "email", header: "Email", rowHeader: true, wrap: true },
  {
    id: "plan",
    header: "Plan",
    type: "tag",
    value: (r) => r.plan === "paid" ? (r.cancelAtPeriodEnd ? "cancelling" : "paid") : "free",
    options: [
      { value: "paid", label: "Paid", tone: "accent" },
      { value: "cancelling", label: "Paid, cancelling", tone: "warning" },
      { value: "free", label: "Free", tone: "secondary" },
    ],
  },
  {
    id: "delivery",
    header: "Email delivery",
    type: "tag",
    value: (r) => r.emailsEnabled ? "on" : "off",
    options: [
      { value: "on", label: "On", tone: "success" },
      { value: "off", label: "Unsubscribed", tone: "danger" },
    ],
  },
  {
    id: "joined",
    key: "createdAt",
    header: "Joined",
    type: "date",
    align: "end",
    format: { month: "short", day: "numeric", year: "numeric" },
  },
];

/** A filter stays chosen: pressing the active one again does not clear it. */
function onFilter(view: { filter: Filter }, value: string, details: { cancel(): void }) {
  if (!value) {
    details.cancel();
    return;
  }

  view.filter = value as Filter;
}

<html lang="en" class="page-admin" (
  subscribers: LiveView<SubscriberRow>,
  private view: { filter: Filter; sorting: { id: string; desc: boolean }[] } = { filter: "all" as Filter, sorting: [{ id: "joined", desc: true }] },
)>
  <head>
    <title>Subscribers · {config.newsletter.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout wide={true}>
      <div class="page-shell is-wide stack is-xl">
        <div class="admin-head row">
          <div class="stack is-xs">
            <p class="eyebrow">Writer</p>
            <h1>{config.newsletter.name}</h1>
          </div>
          <Button variant="primary" href="/admin/posts/new">New post</Button>
        </div>

        <AdminNav active="subscribers" />

        <section class="stats" aria-label="Subscribers" aria-live="polite">
          <Card class="stat">
            <CardContent class="stack is-sm">
              <p class="stat-label">Free subscribers</p>
              <p class="stat-value">{statsOf(subscribers.slice()).free}</p>
              <p class="stat-note">getting letters by email</p>
            </CardContent>
          </Card>
          <Card class="stat">
            <CardContent class="stack is-sm">
              <p class="stat-label">Paid subscribers</p>
              <p class="stat-value">{statsOf(subscribers.slice()).paid}</p>
              <p class="stat-note">at {formatDollars(config.newsletter.priceCents)} a month</p>
            </CardContent>
          </Card>
          <Card class="stat is-revenue">
            <CardContent class="stack is-sm">
              <p class="stat-label">Monthly revenue</p>
              <p class="stat-value">{formatDollars(statsOf(subscribers.slice()).monthlyRevenueCents)}</p>
              <p class="stat-note"><Badge variant="success" dot>Live</Badge></p>
            </CardContent>
          </Card>
        </section>

        <section class="stack">
          <div class="list-head row">
            <h2>Subscribers</h2>
            <ToggleGroup type="single" value={view.filter} variant="outline" size="sm" spacing={1} label="Filter"
                         onValueChange={(value, details) => onFilter(view, value, details)}>
              <ToggleGroupItem value="all">All {subscribers.length}</ToggleGroupItem>
              <ToggleGroupItem value="paid">Paid</ToggleGroupItem>
              <ToggleGroupItem value="free">Free</ToggleGroupItem>
              <ToggleGroupItem value="unsubscribed">Unsubscribed</ToggleGroupItem>
            </ToggleGroup>
          </div>

          <DataTable data={filterRows(subscribers.slice(), view.filter)}
                     columns={COLUMNS}
                     label="Subscribers"
                     sorting={view.sorting}
                     toolbar={false}
                     footer={false}
                     pagination={false}
                     columnMenu={false}
                     resizable={false}
                     reorderable={false}
                     emptyText="Nobody here yet." />
        </section>
      </div>
    </Layout>
  </body>
</html>
